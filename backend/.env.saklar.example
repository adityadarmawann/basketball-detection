# ══════════════════════════════════════════════════════════════════════════════
# Saklar metode gaya Roboflow
#
# Berkas ini TERLACAK git, sedangkan .env tidak (lihat .gitignore). Jadi semua
# penjelasan dan angka hasil pengukuran disimpan di sini, dan .env hanya memuat
# nilai yang sedang dipakai. Salin baris yang diperlukan ke .env.
#
# Aturan umum: setiap saklar punya posisi bawaan = PERILAKU LAMA. Tidak ada
# perhitungan lama yang dihapus, jadi dua duanya bisa dibandingkan bolak balik
# tanpa memproses ulang video.
#
# Semua angka di bawah diukur di q1-UBAYA-UNESA.mp4, 300 frame, pipeline PENUH
# lewat VideoProcessor._process_frame, roster aktif, tiap saklar diuji TERPISAH.
# Alat ujinya: backend/eksperimen/04_verifikasi_penuh.py
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Pembersihan jalur sebelum jarak dihitung ───────────────────────────────
# none | roboflow
# roboflow: MAD buang lonjakan, interpolasi tambal lubang, Savitzky-Golay
# haluskan, lalu pengaman max_step buang langkah yang mustahil secara fisik.
#   Pengaruh ke deteksi, nomor, tim, aksi, kejadian : NOL (semua metrik identik)
#   Biaya waktu                                     : +10 persen
#   Percepatan median                               : 45,3 jadi 19,4 m/s2
# CATATAN PENTING: ini TIDAK memperbaiki jarak. clean_paths menghaluskan
# lonjakan tapi tidak menghapus perpindahannya. Akar celah jarak adalah track_id
# yang pecah (734 id untuk 10 pemain dalam 120 detik), dan itu urusan OCR nomor.
PATH_CLEAN_METHOD=roboflow
PATH_CLEAN_CHUNK=450        # panjang potongan yang diproses sekali jalan
PATH_CLEAN_OVERLAP=30       # ekor yang disimpan agar sambungan mulus
PATH_CLEAN_SIGMA=5.0        # berapa MAD di atas median baru disebut lonjakan
PATH_CLEAN_WINDOW=15        # jendela Savitzky-Golay
PATH_CLEAN_MAX_STEP=0       # 0 = turunkan dari MAX_SPEED_KMH

# ── 2. Penghalusan keypoint sebelum homografi ─────────────────────────────────
# none | roboflow
# DIMATIKAN berdasarkan ukuran, bukan asumsi: frame terkalibrasi TURUN 240 jadi
# 235 (minus 2 persen) dan tidak ada metrik lain yang membaik. Penyebabnya model
# keypoint sekarang hanya memberi 13 dari 33 titik, jadi merata ratakan titik
# yang sedikit dan sering hilang justru mengurangi yang lolos ambang RANSAC.
# Nyalakan lagi SETELAH model keypoint dilatih ulang.
KEYPOINT_SMOOTH_METHOD=none
KEYPOINT_SMOOTH_LEN=3

# ── 3. Validator nomor punggung ───────────────────────────────────────────────
# weighted | consecutive
# TETAP weighted berdasarkan ukuran. Dengan roster aktif seperti produksi:
#     weighted    : 681 bacaan, 14 nomor unik, 0 nomor palsu
#     consecutive : 455 bacaan, 11 nomor unik, 0 nomor palsu
# Presisi keduanya sama sama sempurna, karena penyaring roster SUDAH memblokir
# nomor palsu. Jadi keunggulan presisi consecutive mubazir, sementara kerugian
# recall-nya nyata: 3 nomor pemain hilang.
NUMBER_VALIDATOR=weighted
NUMBER_CONSECUTIVE_N=3

# ── 4. Klasifikasi tim ────────────────────────────────────────────────────────
# lab | siglip
# TETAP lab. SigLIP diuji terpisah: +24 persen waktu (34,3 jadi 42,4 detik)
# tanpa perbaikan terukur. Tim unik tetap A dan B, bacaan tim tetap 1026, dan
# bacaan nomor malah turun sedikit 736 jadi 711.
# Model google/siglip-base-patch16-224 sudah terunduh (779 MB) dan jalurnya
# sudah teruji, jadi bisa dinyalakan kapan saja untuk percobaan offline.
# JANGAN pakai cuda saat ada training lain berjalan.
TEAM_METHOD=lab
TEAM_SIGLIP_DEVICE=cpu
TEAM_SIGLIP_EVERY=5         # SigLIP dipanggil setiap N potongan (83 ms per potongan di CPU)
TEAM_SIGLIP_SEED=40         # potongan pembibitan sebelum KMeans dilatih
TEAM_SIGLIP_REDUCER=pca     # ganti ke umap kalau umap-learn dipasang
SIGLIP_CONFIDENT_MARGIN=0.25

# ── 5. Ganti sudut kamera ─────────────────────────────────────────────────────
# Rekaman campus league sering berganti sudut. Diukur di q1 UBAYA UNESA, 60
# detik, 279 pengukuran geser keypoint:
#     persentil 50 :  16,5 px      persentil 95 : 164,0 px
#     persentil 75 :  33,8 px      persentil 99 : 408,8 px
#     persentil 90 :  79,2 px      maksimum     : 584,9 px
# Dengan 120 px, ganti sudut terdeteksi SEKALI PER 3,0 DETIK. Terbukti jalan:
# 9 pemicu dalam 24 detik, 5 melepas kuncian (18 dan 13 nomor sekaligus).
# Saat terpicu: kuncian nomor dilepas, dan penampung jarak ditutup supaya
# lompatan posisi akibat homografi baru tidak tercatat sebagai perpindahan asli.
# JANGAN di bawah 80 px: konfirmasi ulang butuh sekitar 0,25 detik, jadi jendela
# lebih pendek dari sekitar 2 detik membuat nomor tidak pernah selesai terkunci.
COURT_CUT_PX=120
NUMBER_UNLOCK_ON_CUT=1      # hanya berpengaruh pada NUMBER_VALIDATOR=consecutive

# ── 6. Jalur RF-DETR, BELUM AKTIF sampai bobotnya ada ─────────────────────────
# Nyalakan setelah models/rfdetr-basket.pth ada dan `pip install rfdetr`
# dijalankan di env dev cl-gpu. Kalau dinyalakan terlalu dini, create_detector()
# jatuh kembali ke YOLO dan mencatat alasannya, pipeline tidak mati.
# Resep training lengkap: basketball-roboflow/catatan-model-baru-dan-training.txt
DETECTOR_METHOD=yolo        # yolo | rfdetr
ACTION_SOURCE=videomae      # videomae | detector
SHOT_METHOD=legacy          # legacy | roboflow
RFDETR_WEIGHTS=rfdetr-basket.pth
RFDETR_VARIANT=medium       # CADANGAN saja; from_checkpoint menentukan sendiri
RFDETR_TRUST=1              # memuat .pth menjalankan pickle
RFDETR_CONF=0.35
RFDETR_NUMBER_IOS=0.60      # ambang Mask IoS pencocokan kotak nomor ke pemain
RFDETR_ATTACH_IOU=0.70      # ambang IoU penyambung deteksi ke hasil pelacakan
# Offset indeks kelas. DIUKUR dengan bobot starter COCO: RF-DETR mengembalikan
# class_id [1, 37], yaitu id kategori COCO yang MULAI DARI 1, bukan 0. Salah
# satu langkah di sini menggeser SEMUA kelas tanpa pesan kesalahan apa pun.
# Adaptor memeriksa sendiri dan mencatat ERROR dengan nilai perbaikannya.
RFDETR_CLASS_OFFSET=1
RFDETR_PERIKSA_FRAME=20

# ── 7. Potongan resolusi asli di sekitar ring, dan gerbang tepi rim ──────────
# Dua duanya BAWAAN MATI. Tidak mengisinya berarti perilaku lama persis sama.
#
# MASALAHNYA: frame utuh 1280x720 diperkecil ke 576x576 sebelum masuk RF-DETR
# (skala x 0,45, y 0,80), jadi bola selebar 21 px terlihat 9,5 px oleh model.
# Itu sebab bola hilang tepat pada saat menentukan.
#
# HOOP_ROI_ENABLE: saat rim terdeteksi, potongan persegi di sekitar rim diambil
# dari frame RESOLUSI ASLI lalu detektor dijalankan pada potongan itu. Potongan
# 448 diperbesar ke 576, jadi bola yang sama terlihat 27 px. HANYA kelas ball
# yang diambil dari potongan, jadi tidak ada benda lain yang terhitung dua kali.
# TERUKUR, skrip 21 dan 17, q1_4menit.mp4, kebenaran 5 bola masuk 11 poin:
#     setelan                 asli   nilai   palsu   poin   waktu
#     mati (acuan)            2/5      2       2       9    16,1 menit
#     hidup, 448, near 300    3/5      3       3      13    16,9 menit
# Keyakinan bola median 0,820 jadi 0,869, dan potongan lebih yakin pada 77,9
# persen frame. Satu bola masuk ASLI yang tadinya terlewat (detik 19) ditemukan,
# dengan tambahan satu palsu. Biaya waktu +5 persen saja karena gerbang jarak.
# TERUKUR DAN DITERIMA 10 Oktober 2026, bersama FG_RIM_GATE. Skrip 17,
# potongan 240 detik, kebenaran 5 bola masuk 11 poin:
#                       asli   palsu   ketepatan   waktu
#   acuan awal           2/5     2        50 %    16,1 mnt
#   gerbang rim saja     2/5     1        67 %    16,4 mnt
#   ROI saja             3/5     3        50 %    16,9 mnt
#   ROI + gerbang rim    3/5     2        60 %    16,9 mnt
# Tawar menawarnya: dibanding gerbang rim saja, ROI menambah satu bola masuk
# yang ditemukan tapi ketepatan turun 67 jadi 60 persen. Dipilih menyala karena
# bola masuk yang TERLEWAT tidak bisa dipulihkan di tahap mana pun, sedangkan
# palsu masih bisa dipangkas gerbang berikutnya. Isi 0 kalau mengejar ketepatan.
HOOP_ROI_ENABLE=1
HOOP_ROI_SIZE=448           # sisi potongan dalam piksel frame ASLI
# Gerbang jarak, supaya waktu prosesnya tidak meledak. Potongan hanya jalan
# kalau bola terakhir yang diketahui ada dalam jarak ini dari pusat rim.
# TERUKUR: potongan di SETIAP frame = +73 persen waktu detektor (12,0 ms per
# potongan lawan 16,4 ms per frame penuh). Dengan 300 px potongan jalan di
# 28,6 persen frame dan hanya 34 dari 179 pengisian celah yang hilang.
# 0 berarti SELALU jalan; itu untuk pengukuran, bukan produksi.
HOOP_ROI_NEAR_PX=300
HOOP_ROI_HIST_F=15          # umur maksimum ingatan posisi bola, dalam frame
HOOP_ROI_CONF=0             # 0 = ikut ambang bola biasa
# Aturan gabung, supaya satu bola TIDAK jadi dua. Keluaran ball satu slot jadi
# berganda mustahil secara bentuk; ini mengatur SIAPA YANG MENANG saat keduanya
# ada. Dalam jarak ini = bola yang SAMA, potongan menang karena resolusinya
# lebih tinggi. Lebih jauh = tidak sepakat objeknya, frame penuh DIPERTAHANKAN.
HOOP_ROI_OVERLAP_PX=60
HOOP_ROI_EDGE_PX=2          # kotak yang menyentuh tepi potongan ditolak
#
# FG_RIM_GATE: uji bola masuk memakai rentang mendatar KOTAK RIM, bukan
# lingkaran radius FG_HOOP_RADIUS_PX di sekitar pusat ring. Kotak rim terukur
# 38,0 px lebar, jadi lingkaran 45 px menerima bola yang pusatnya lebih dari
# dua kali separuh lebar cincin ke samping. Garis "sudah di bawah" juga diambil
# dari tepi bawah kotak rim, bukan dari konstanta setelan.
# Mundur SENDIRI ke lingkaran kalau kotak rim tidak ada (detektor YOLO, atau
# ring sintetis dari homografi yang cuma punya titik tengah) atau kalau kotak
# rim terakhir sudah basi. Jadi menyalakannya tidak pernah mematikan deteksi.
# Syarat "WAJIB deteksi NYATA untuk konfirmasi di bawah rim" TIDAK disentuh.
#
# TERUKUR DAN DITERIMA, 10 Oktober 2026. Potongan 240 detik Q1 UNESA-UBAYA
# (/home/paul/q1_4menit.mp4), kebenaran 5 bola masuk dan 11 poin, skrip 17:
#
#                     asli   palsu   poin   waktu
#   lingkaran 45 px    2/5     2       9    16,1 mnt
#   tepi kotak rim     2/5     1       7    16,4 mnt
#
# Yang dibuang tepat sasaran: deteksi 1:38, bola 0,5 m dari ring yang lewat DI
# SAMPING cincin. Masuk lingkaran 45 px, di luar separuh lebar kotak rim yang
# 19 px. Tidak ada bola masuk asli yang hilang, biaya waktu 2 persen.
#
# AWAS SALAH BACA: poinnya MENJAUH dari kebenaran 11, dan itu BUKAN kemunduran.
# Palsu 1:38 bernilai 2 angka dan selama ini MENAMBAL satu bola masuk yang
# terlewat, sehingga angka 9 terlihat lebih dekat ke 11 hanya karena ada
# karangan yang menutupi kekurangan. Nilai PER KEJADIAN, jangan dari total skor.
FG_RIM_GATE=1
FG_RIM_X_MARGIN_PX=0        # margin mendatar di luar tepi kotak rim
# FG_RIM_Y_BAND_PX: jalur tegak uji zona, di atas dan di bawah pusat rim.
# JANGAN diisi kalau tidak perlu; bawaannya mengikuti FG_HOOP_RADIUS_PX supaya
# jangkauan TEGAK tidak berubah dari lingkaran dan yang berbeda hanya ketajaman
# MENDATAR. Dengan begitu kalau hasilnya berubah, sebabnya jelas tepi rim,
# bukan dua perubahan sekaligus. Untuk RF-DETR bawaannya 45.
# FG_RIM_Y_BAND_PX=45
